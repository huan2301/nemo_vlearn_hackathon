# Groq API key.
GROQ_API_KEY=your_groq_api_key_here
# GROQ_KEY is also accepted as a typo-tolerant alias.

# Optional secondary key for fallback requests.
GROQ_FALLBACK_API_KEY=

# Default model order.
# Primary & Fallback Groq Models
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.3-70b-lite
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Optional Gemini API key & Models for Fallback
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRIMARY_MODEL=gemini-1.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash-8b

# Request Timeout (seconds)
REQUEST_TIMEOUT=15